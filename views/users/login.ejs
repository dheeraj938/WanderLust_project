<%- layout("layouts/auth-boilerplate") %>

<div class="login-container">
  <div class="login-wrapper">
    <div class="login-card">
      <!-- Header Section -->
      <div class="login-header">
        <div class="login-icon-wrapper">
          <i class="fas fa-compass"></i>
        </div>
        <h1 class="login-title">Welcome Back</h1>
        <p class="login-subtitle">To Wanderlust Adventures</p>
      </div>

      <!-- Form Section -->
      <form action="/login" method="POST" class="login-form needs-validation" novalidate>
        <!-- Username Field -->
        <div class="form-group-custom">
          <div class="input-wrapper">
            <i class="fas fa-user input-icon"></i>
            <input 
              name="username" 
              id="username" 
              type="text" 
              class="form-control-custom" 
              placeholder="Enter your username"
              required
            >
            <div class="form-focus-line"></div>
          </div>
          <small class="form-text-help">Your account username</small>
        </div>

        <!-- Password Field -->
        <div class="form-group-custom">
          <div class="input-wrapper">
            <i class="fas fa-lock input-icon"></i>
            <input 
              name="password" 
              id="password" 
              type="password" 
              class="form-control-custom" 
              placeholder="Enter your password"
              required
            >
            <i class="fas fa-eye toggle-password" id="togglePassword"></i>
            <div class="form-focus-line"></div>
          </div>
          <small class="form-text-help">Keep it secure</small>
        </div>

        <!-- Remember Me -->
        <div class="remember-wrapper">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <label for="rememberMe">Remember me</label>
        </div>

        <!-- Login Button -->
        <button type="submit" class="login-btn">
          <span class="btn-text">Sign In</span>
          <i class="fas fa-arrow-right btn-icon"></i>
        </button>

        <!-- Divider -->
        <div class="login-divider">
          <span>Don't have an account?</span>
        </div>

        <!-- Signup Link -->
        <a href="/signup" class="signup-link">
          Create Account Now
        </a>
      </form>

      <!-- Made By Section -->
      <div class="made-by-section">
        <p class="made-by-text">
          <i class="fas fa-heart"></i>
          Made with passion by <span class="creator-name">Dheeraj</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Decorative Background Elements -->
  <div class="login-bg-decoration decoration-1"></div>
  <div class="login-bg-decoration decoration-2"></div>
  <div class="login-bg-decoration decoration-3"></div>
</div>